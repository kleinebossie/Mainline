# Copy to .env.local and fill in. Never commit real secrets (VISION §7).

# --- Database (Supabase free tier) ---
# Used by Prisma for migrations and runtime. Supabase: Project Settings → Database → Connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with:  npx auth secret
AUTH_SECRET=""

# --- Google OAuth (sign-in provider) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Lichess OAuth (sign-in + connection provider, M1) ---
# Lichess is a PUBLIC PKCE client: NO secret, and NO app registration required.
# client_id is just a self-chosen identifier shown on the Lichess consent screen.
# OPTIONAL — leave this line commented out to use the default ("mainline").
# (Do NOT set it to an empty string "" — Lichess rejects an empty client_id.)
# Callback URL http://localhost:3000/api/auth/callback/lichess is handled automatically.
# LICHESS_CLIENT_ID="mainline"

# --- Outbound platform calls (M1) ---
# Descriptive User-Agent sent to Lichess/Chess.com (Chess.com 403s without one).
# OPTIONAL — leave commented to use a sensible default; set a contact id in production.
# CHESS_API_USER_AGENT="mainline/0.1.0 (contact: you@example.com)"

# --- Background import cron (M2) ---
# Protects the /api/cron/import route. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>`. Generate a random value, e.g.:
#   openssl rand -hex 32
# Set the SAME value in the Vercel project's Environment Variables. The route fails
# closed (401) if this is unset, so the import cron only runs once it is configured.
CRON_SECRET=""
