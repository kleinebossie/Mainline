# Copy to .env.local and fill in. Never commit real secrets (VISION §7).

# --- Database (Supabase free tier) ---
# Used by Prisma for migrations and runtime. Supabase: Project Settings → Database → Connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# Dedicated local disposable database for Playwright E2E testing (must target localhost and contain 'e2e' or 'playwright' in DB name).
# PLAYWRIGHT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mainline_e2e"

# --- Auth.js (NextAuth v5) ---
# Generate with:  npx auth secret
AUTH_SECRET=""

# --- Google OAuth (sign-in provider) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Lichess OAuth (sign-in + connection provider, M1) ---
# Lichess is a PUBLIC PKCE client: NO secret, and NO app registration required.
# client_id is just a self-chosen identifier shown on the Lichess consent screen.
# OPTIONAL — leave this line commented out to use the default ("mainline").
# (Do NOT set it to an empty string "" — Lichess rejects an empty client_id.)
# Callback URL http://localhost:3000/api/auth/callback/lichess is handled automatically.
# LICHESS_CLIENT_ID="mainline"

# --- Outbound platform calls (M1) ---
# Descriptive User-Agent sent to Lichess/Chess.com (Chess.com 403s without one).
# OPTIONAL — leave commented to use a sensible default; set a contact id in production.
# CHESS_API_USER_AGENT="mainline/0.1.0 (contact: you@example.com)"

# --- Closed-beta access and per-user external API budgets (M15) ---
# Comma-separated break-glass owner emails. Keep this narrow in production. Existing
# database users with role=admin are also admitted if an OAuth provider returns no email.
BETA_OWNER_EMAILS=""
# Optional fixed-window request caps. Platform calls default to 120 per user/hour.
# Manual PGN checks and imports share a separate 60-request per-user/hour bucket.
# LICHESS_API_REQUESTS_PER_HOUR="120"
# CHESSCOM_API_REQUESTS_PER_HOUR="120"
# MANUAL_IMPORT_REQUESTS_PER_HOUR="60"

# --- Daily operations cron (M15) ---
# Protects /api/cron/daily and the manual /api/cron/import recovery route. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>`. Generate a random value, e.g.:
#   openssl rand -hex 32
# Set the SAME value in the Vercel project's Environment Variables. The route fails
# closed (401) if this is unset, so the import cron only runs once it is configured.
CRON_SECRET=""

# --- Controlled observational research export (P9) ---
# Required only for the admin-only export. Generate a separate high-entropy secret,
# review the current notice with the owner, then configure the same value in production.
# The export fails closed when this is absent or shorter than 32 characters.
RESEARCH_EXPORT_SECRET=""

# --- Privacy-safe error monitoring (M15) ---
# Create a Sentry project with request bodies and default PII disabled. Mainline also
# removes headers, cookies, query strings, user identity, payloads, free text, and raw
# exception messages in its own beforeSend filter.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Needed only in CI/deployment when uploading source maps. Scope it to the one project.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Methodology release selection ---
# OPTIONAL: pin a released version for staged rollout or rollback.
# Defaults to research-1.0.0 when omitted.
# METHODOLOGY_VERSION="stub-0.1.0"
