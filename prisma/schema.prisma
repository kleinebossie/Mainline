// Single source of DB truth (BUILD.md §4, §5). M0 ships the Auth.js identity
// tables; M1 adds identity fields (§5.1) + PlatformConnection (§5.2); M2 adds
// ChessProfileSnapshot + ImportedGame (§5.2) and the JobRun ledger (§5.7); M3 adds
// the resource catalog — LichessPuzzle + ResourceRef (§5.3); M4 adds Assessment +
// ConstraintSet (§5.4); M5 adds AnalysisResult — raw, client-computed game features
// (§5.2); M6 adds Program + ProgramItem — the generated daily session with its
// denormalised transparency snapshot (§5.5); M7 closes the loop with the tracker +
// adaptation state — ActivityEvent (append-only), SkillState, ScheduleState (FSRS),
// and AdaptationLog (§5.5/§5.6); M9 adds the engagement plumbing — RewardEvent
// (append-only) + NotificationPref (capped reminders) (§5.7). The rest of the data
// model (§5) lands milestone by milestone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth v5) standard tables (BUILD.md §5.1) ---

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  // Identity fields (BUILD.md §5.1). `patronStatus` is a billing-capable
  // reservation — no billing is built in Phase 1 (VISION §7).
  locale              String    @default("en")
  role                String    @default("user") // user | admin
  patronStatus        String    @default("none") // none | patron
  // The platform the user treats as their "home" account — defaults the game picker and
  // analysis surfaces. Nullable: when unset we infer it from the most recent imported game.
  primaryPlatform     String? // lichess | chesscom
  betaAccessGrantedAt DateTime?
  deletedAt           DateTime? // soft-delete for GDPR export/erase
  deletionToken       String?   @unique // opaque purge correlation, never contains the user id
  deletionRequestedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  platformConnections     PlatformConnection[]
  chessProfileSnapshots   ChessProfileSnapshot[]
  importedGames           ImportedGame[]
  assessment              Assessment?
  constraintSets          ConstraintSet[]
  programs                Program[]
  activityEvents          ActivityEvent[]
  skillStates             SkillState[]
  skillStateSnapshots     SkillStateSnapshot[]
  scheduleStates          ScheduleState[]
  trainingPreferenceState TrainingPreferenceState?
  weeklyFocuses           WeeklyFocus[]
  weeklyAvailability      WeeklyAvailability?
  availabilityOverrides   AvailabilityOverride[]
  programDayForecasts     ProgramDayForecast[]
  programRevisions        ProgramRevision[]
  adaptationLogs          AdaptationLog[]
  rewardEvents            RewardEvent[]
  notificationPref        NotificationPref?
  practiceItems           PracticeItem[]
  allowlistEntries        AllowlistEntry[]
  apiCallBudgets          ApiCallBudget[]
  researchConsents        ResearchConsent[]
}

// Optional secondary-use consent is separate from account creation and operational
// training. Each grant is an audit row. Withdrawal closes that grant; regrant creates
// a new row under the then-current notice version.
model ResearchConsent {
  id            String    @id @default(cuid())
  userId        String
  noticeVersion String
  scopes        String[]
  grantedAt     DateTime
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, grantedAt])
  @@index([userId, noticeVersion, withdrawnAt])
}

// Minimal post-erasure proof. The token is random and cannot identify an account
// without the User row, which hard deletion removes.
model AccountPurgeLedger {
  token       String    @id
  requestedAt DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Closed-beta admission gate (BUILD.md §5.1, M15). Entries may target an email or
// carry a one-time invite code. `usedByUserId` records the account that claimed an
// entry so an invite cannot silently admit multiple accounts.
model AllowlistEntry {
  id           String    @id @default(cuid())
  email        String?
  inviteCode   String?   @unique
  usedByUserId String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  usedByUser User? @relation(fields: [usedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([usedByUserId])
}

// Per-user, per-platform external request bucket (BUILD.md §5.7, §12, M15).
// Window arithmetic and limits are infrastructure policy in src/server/api-budget.ts.
model ApiCallBudget {
  id          String   @id @default(cuid())
  userId      String
  platform    String // lichess | chesscom
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, windowStart])
  @@index([userId, windowStart])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Platform connections (BUILD.md §5.2, §6) ---

// A linked chess account. Lichess connections carry OAuth2 PKCE tokens; Chess.com
// connections are username-only and store NO tokens (§6.3 — read-only PubAPI).
model PlatformConnection {
  id               String    @id @default(cuid())
  userId           String
  platform         String // lichess | chesscom
  externalUsername String
  // Lichess only — Chess.com is tokenless (§6.3). `isLoginProvider` on the
  // adapter (§6) is the source of truth for whether tokens are expected.
  accessToken      String?
  refreshToken     String?
  scopes           String?
  status           String    @default("active") // active | error | revoked
  connectedAt      DateTime  @default(now())
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

// --- Chess data: snapshots + imported games (BUILD.md §5.2) ---

// Point-in-time ratings + counts for a platform (time series feeds the Measurement
// seam). Keyed by (userId, platform) rather than an FK to PlatformConnection so the
// series survives a disconnect/reconnect. `ratings` is `{ format: { rating, rd,
// games } }`; `raw` keeps the untouched provider payload. Nothing here is
// interpreted (L1).
model ChessProfileSnapshot {
  id         String   @id @default(cuid())
  userId     String
  platform   String // lichess | chesscom
  capturedAt DateTime
  ratings    Json
  totalGames Int
  raw        Json
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, capturedAt])
}

// One imported game. Idempotency is enforced by the unique (userId, dedupeKey):
// re-importing the same game is a no-op (createMany skipDuplicates). Only raw,
// uninterpreted facts are stored (L1). AnalysisResult (M5) attaches 1—0..1 later.
model ImportedGame {
  id               String   @id @default(cuid())
  userId           String
  platform         String // lichess | chesscom
  externalGameId   String
  dedupeKey        String // e.g. `${platform}:${externalGameId}`
  pgn              String
  playedAt         DateTime
  timeControl      String?
  color            String? // w | b
  result           String? // win | loss | draw
  userRatingAtGame Int?
  opponentRating   Int?
  eco              String?
  opening          String?
  source           String // lichess | chesscom
  importedAt       DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis AnalysisResult?

  @@unique([userId, dedupeKey])
  @@index([userId, playedAt])
}

// Raw engine features for one imported game (BUILD.md §5.2, M5). RAW MEASUREMENTS ONLY
// (L1): no interpreted or graded field ever lands here — "good/bad" judgement is Seam 3
// (interpretGameFeatures), which CONSUMES this. Features are computed CLIENT-SIDE by
// Stockfish WASM (§6.5), so the server only persists what the browser sends (zero server
// compute). 1—1 with the game it analyses; cascades when the game (hence the user) is
// deleted (GDPR). `rawFeatures` is the RawGameFeatures shape (src/lib/raw-features.ts),
// validated by its Zod schema at the tRPC boundary before it is stored.
model AnalysisResult {
  id            String   @id @default(cuid())
  gameId        String   @unique
  engineVersion String // e.g. "stockfish-18-lite" — provenance for reproducibility
  depth         Int // the bounded search depth the features were computed at
  rawFeatures   Json // RawGameFeatures (uninterpreted measurements only, L1)
  analyzedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  game ImportedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

// --- Background-job ledger (BUILD.md §5.7) ---

// Idempotent ledger for background jobs (import sync, ingest, adaptation cron). The
// unique `key` is the idempotency token: a job claims its key before running so a
// retried cron tick or double-trigger does not duplicate work.
model JobRun {
  id          String    @id @default(cuid())
  kind        String // import_sync | ingest | adaptation
  key         String    @unique
  status      String    @default("running") // queued | running | success | error
  attempt     Int       @default(1)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  lockedUntil DateTime?
  error       String? // sanitized operator-safe summary, never an upstream payload
  errorCode   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, startedAt])
  @@index([kind, status])
}

// --- Resource catalog: external puzzle DB + resource references (BUILD.md §5.3, §6.4) ---

// An ingested slice of the Lichess open puzzle DB (CC0). Global, not user-owned. The
// full DB (~millions of rows) exceeds the Supabase free 500 MB tier (§6.4, §12), so
// scripts/ingest-puzzles.ts ingests a rating-×-theme-stratified subset with full band
// coverage and an on-demand fallback for gaps. Theme + rating selection is powered by
// the GIN index on `themes` and the btree on `rating`. Raw catalog facts only — no
// interpretation or grade (L1); WHICH theme addresses WHICH weakness is Seam 4
// methodology, decided later, never stored here.
model LichessPuzzle {
  puzzleId        String   @id
  fen             String
  moves           String // space-separated UCI solution moves
  rating          Int
  ratingDeviation Int
  popularity      Int
  nbPlays         Int
  themes          String[] // Lichess theme tags, e.g. ["fork", "mateIn2"]
  gameUrl         String?
  openingTags     String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([rating])
  @@index([themes], type: Gin)
}

// An external resource a program can point at (never hosted content — VISION §6).
// `externalUrl` must resolve to a real external page (e.g. a Lichess training theme:
// https://lichess.org/training/<theme>). `metadata` is a typed-in-lib JSON blob.
// `methodologyKey` (optional) links a catalog entry to a Seam-4 ActivityDefinition and
// is populated once the methodology layer lands (M4+). Seeded idempotently with
// deterministic ids by scripts/seed-resources.ts.
model ResourceRef {
  id             String        @id @default(cuid())
  type           String // lichess_puzzle_theme | book | endgame_trainer | study | master_game_collection | video
  title          String
  externalUrl    String?
  provider       String
  metadata       Json
  methodologyKey String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  programItems   ProgramItem[]

  @@index([type])
}

// --- Assessment & constraints (BUILD.md §5.4) ---

// Onboarding behavioural calibration (Seam 2). One row per user (upserted as the
// adaptive ladder progresses). `calibrationResponses` is the append-only list of
// CalibrationResponse ({ ratingShown, correct }) — BEHAVIOURAL evidence only; skill is
// NEVER taken from self-report (Seam 2 / Dunning-Kruger). `tacticalRatingEstimate` +
// `uncertainty` are produced by the pure `scoreCalibration` (graded, best-guess);
// `derivedSkillSeed` seeds SkillState in M6/M7. `methodologyVersion` records the config
// the estimate was scored under (reproducibility, §2.6).
model Assessment {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  completedAt            DateTime?
  calibrationResponses   Json
  tacticalRatingEstimate Int?
  uncertainty            Int?
  derivedSkillSeed       Json?
  methodologyVersion     String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The user's reality (BUILD.md §5.4): current + history. Exactly one row per user has
// `isCurrent = true` (the latest version feeds the generator, M6); saving a new set
// supersedes the previous current row and bumps `version`. `goals`/`formatPrefs`/
// `ifThenPlan` are typed via lib/constraints.ts Zod. All self-report here is
// constraints/goals/resources — never a skill claim (Seam 2 boundary).
model ConstraintSet {
  id             String   @id @default(cuid())
  userId         String
  minutesPerDay  Int
  daysPerWeek    Int
  goals          Json
  // Structured owned resources `{ kind, label, externalRef? }[]` (lib/constraints Zod).
  // Was String[]; widened to Json so the generator can match what a user actually owns.
  ownedResources Json     @default("[]")
  formatPrefs    Json
  // Depth-vs-breadth + interleave preference `{ depthVsBreadth, interleave }` (Seam 7 input).
  sessionStyle   Json?
  ifThenPlan     Json?
  isCurrent      Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
}

// --- Program & tracking (BUILD.md §5.5, M6) ---

// A generated plan instance. `generationInput` snapshots the inputs the generator ran on
// (band, tactical rating, weakness signals, constraints, due items) so any "Today" can be
// re-derived (reproducibility, L2). `methodologyVersion` records the config it was produced
// under; `status` flips active → superseded when a newer program is generated.
model Program {
  id                 String   @id @default(cuid())
  userId             String
  methodologyVersion String
  status             String   @default("active") // active | superseded
  generationInput    Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ProgramItem[]

  @@index([userId, status])
}

// One activity in a day. The transparency snapshot (rationaleText/evidenceGrade/
// evidenceTier/citationKey/confidence/soften) is DENORMALISED at generation time (L3,
// §5.5) so a later config bump never silently rewrites a persisted "why". `params` is the
// ProgramItemParams JSON (theme, track, targetRating, count, structure, …); `activityId`
// is the Seam-4 activity that produced it (kept for M7 adaptation). ActivityEvent (M7)
// attaches 1—* later. resourceRef is optional (set when the catalog has a matching entry).
model ProgramItem {
  id                 String   @id @default(cuid())
  programId          String
  date               DateTime
  orderIndex         Int
  activityId         String
  activityType       String
  resourceRefId      String?
  params             Json
  dimensionsTargeted String[]
  rationaleKey       String
  rationaleText      String
  evidenceGrade      String // A | B | C | D
  evidenceTier       Int // 1 | 2
  citationKey        String
  confidence         String // insufficient | low | medium | high
  soften             Boolean
  status             String   @default("pending") // pending | done | skipped
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  resourceRef    ResourceRef?    @relation(fields: [resourceRefId], references: [id], onDelete: SetNull)
  activityEvents ActivityEvent[]

  @@index([programId, date, orderIndex])
}

// --- Tracker + adaptation: the loop closes (BUILD.md §5.5, §5.6, M7) ---

// The append-only tracker log (§5.5): every outcome is one immutable row — never updated
// or deleted. It is the substrate the adaptation loop reads. `payload` is the
// ActivityEventPayload JSON ({ correct?, solveTimeMs?, durationMin?, externalRef? },
// typed in lib/tracker.ts). `programItemId` links the outcome to the activity it came
// from (so the loop can resolve the item's config dimensions/track); it is nullable for
// outcomes with no on-screen item (e.g. an imported game). Indexed by (userId,
// occurredAt) for "events since last run".
model ActivityEvent {
  id            String   @id @default(cuid())
  userId        String
  programItemId String?
  type          String // puzzle_attempt | drill_done | game_played | skip | self_report
  occurredAt    DateTime
  payload       Json
  source        String   @default("user") // user | import | system
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  programItem ProgramItem? @relation(fields: [programItemId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

// Per-dimension skill estimate (§5.5). The adaptation loop maintains a v0 competence
// proxy — the running success proportion over the dimension's logged outcomes — with its
// standard error as `uncertainty` (generic statistics in engine/math/estimate.ts, not a
// graded chess constant). One row per (userId, dimension). This is the *latest* state —
// upserted on every adaptation pass so the dashboard and the decision-state assembler can
// read it cheaply. The immutable history of every adaptation pass lands in
// `SkillStateSnapshot` (P4). Consumed by the dashboard (M8) and the longitudinal decision
// input (P4); generation still drives difficulty off the calibrated tactical rating in v0.
model SkillState {
  id          String   @id @default(cuid())
  userId      String
  dimension   String // a Seam-1 dimension id
  estimate    Float
  uncertainty Float
  sampleSize  Int
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dimension])
  @@index([userId])
}

// Immutable per-dimension skill snapshot written after each adaptation run (P4). One row
// per (userId, dimension, capturedAt) — append-only, never updated or deleted (except by
// the User cascade). `methodologyVersion` records which config produced the estimate so any
// historic point can be re-derived; `runAt` is the adaptation run's logical time (the same
// clock-stamped runAt of the AdaptationLog that produced this snapshot). The latest state
// stays in `SkillState` (an upserted single row); this table is the longitudinal history
// the decision-state assembler reads to give the generator a memory beyond "now".
model SkillStateSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  dimension          String // a Seam-1 dimension id
  estimate           Float
  uncertainty        Float
  sampleSize         Int
  methodologyVersion String
  runAt              DateTime // the adaptation run's logical time (matches AdaptationLog.runAt)
  capturedAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dimension, runAt])
  @@index([userId, runAt])
}

// Spacing/due state per spaced item (§5.5, FSRS). `due` is a top-level indexed column
// (the queryable "what's due today" key) mirroring `fsrsState.due`; `fsrsState` carries
// the full FSRS memory state ({ stability, difficulty, due, reps, lapses, lastReview })
// for re-stepping. The math is the generic engine `fsrsStep`; ALL parameters come from
// the Seam-6 `scheduling` config. `itemRef`/`itemType` identify the spaced item (v0: a
// puzzle theme, e.g. itemType "puzzle_theme", itemRef "fork"). Unique per (userId,
// itemType, itemRef) so a repeat failure re-steps the same row.
model ScheduleState {
  id        String   @id @default(cuid())
  userId    String
  itemRef   String
  itemType  String
  fsrsState Json
  due       DateTime
  lastGrade Int? // last FSRS grade 1..4
  source    String   @default("redo") // redo | drill
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemRef])
  @@index([userId, due])
}

// A generated/curated in-app practice position (§5.3, M12/M13). `userId` null = a
// shared/curated position; set = personal (e.g. a blunder drill derived from the user's
// own game). `kind` is the activity family (blunder_drill | endgame | …). `fen` is the
// position the solver faces; `solutionLine` is its known answer (UCI/SAN moves the
// player must find — the engine's best line for a blunder drill). `sourceRef` ties it to
// its origin (e.g. "blunder:<gameId>:<ply>") and is UNIQUE per user so re-deriving the
// same blunder is idempotent. It holds NO graded merit — *which* position to drill is the
// methodology's call (Seam 4); this row is only the position + its known solution. Spaced
// via ScheduleState (itemType "blunder_drill", itemRef = PracticeItem.id).
model PracticeItem {
  id             String   @id @default(cuid())
  userId         String?
  kind           String // blunder_drill | endgame
  fen            String
  solutionLine   String[]
  sourceRef      String? // e.g. "blunder:<gameId>:<ply>" — idempotency key for re-derivation
  methodologyKey String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRef])
  @@index([userId, kind])
}

// Cached Lichess tablebase lookups (§5.3, §6.6, M13). Endgame ground truth (WDL/DTZ +
// the best move for a ≤7-piece FEN) is IMMUTABLE for a given position, so we fetch once
// and reuse forever — "respect the platform" (VISION §6, §12): never re-hit Lichess for a
// FEN we have already seen. `fen` is the natural key; `result` is the parsed tablebase
// payload ({ category, dtz, dtm, precise, checkmate, stalemate, bestMove, bestMoveSan }),
// typed via Zod in lib/. Global (not user-owned) — the same position answers for everyone.
model TablebaseCache {
  fen       String   @id
  result    Json
  fetchedAt DateTime @default(now())
}

// Why the program changed (§5.6) — transparency for the loop. Each run records its
// trigger, the input snapshot it ran on (reproducibility, L2), and the ordered
// `decisions` (each carrying its rationaleKey + evidence grade, L3), under the
// `methodologyVersion` it used. Surfaced in the dashboard (M8).
model AdaptationLog {
  id                 String   @id @default(cuid())
  userId             String
  runAt              DateTime
  trigger            String // new_events | new_import | daily_cron
  inputsSnapshot     Json
  decisions          Json
  methodologyVersion String
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runAt])
}

// Derived training-fit preferences only — NEVER a skill estimate (P4/P8 boundary). This is
// the deterministic rollup P8 computes from TrainingFeedback (enjoyment, resource,
// scheduling, friction) that P5's weekly focus consumes alongside SkillState. Subjective
// feedback writes here; it can NEVER write SkillState or fabricate a weakness signal
// (roadmap-wide invariant, §9). P4 ships the table and the reset surface with an empty
// default; P8 is the first writer. One row per user.
//   `preferences` — the derived fit state (a typed JSON shape, lib/decision-input).
//   `userOverride` — a user-side correction stored when the user explicitly resets or
//   pins a preference (P8). Null when no override is active.
//   `resetAt` — when the rollup was last reset (P8). Null until the first reset.
model TrainingPreferenceState {
  id           String    @id @default(cuid())
  userId       String    @unique
  preferences  Json
  userOverride Json?
  resetAt      DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Persisted weekly prescription (P5). Decisions and alternatives are immutable JSON
// snapshots produced by the methodology provider. A newer row supersedes the active row;
// historic rows remain inspectable and reproducible from `inputSnapshot`.
model WeeklyFocus {
  id                  String   @id @default(cuid())
  userId              String
  weekStart           DateTime
  focusAreas          String[]
  supportingSignals   Json
  confidence          String
  methodologyVersion  String
  inputSnapshot       Json
  status              String   @default("active") // active | superseded
  rationaleSnapshots  Json
  alternatives        Json
  selectedAlternative String?
  revisionTrigger     String?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, weekStart])
  @@index([userId, createdAt])
}

// P6 scheduling preferences. Flexible is a durable, explicit choice, not an inferred
// weekday schedule. `defaultMinutesByDay` is keyed by UTC weekday (0 through 6).
model WeeklyAvailability {
  id                  String    @id @default(cuid())
  userId              String    @unique
  mode                String    @default("flexible") // flexible | preferred
  preferredWeekdays   Int[]
  defaultMinutesByDay Json
  promptResolvedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A one-date exception. Null minutes means use the weekly/default constraint budget.
model AvailabilityOverride {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  minutes     Int?
  unavailable Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// Immutable forecast version for one date. Reforecasting supersedes a row and appends
// another; activity blocks intentionally contain no concrete puzzle or position ids.
model ProgramDayForecast {
  id                 String   @id @default(cuid())
  userId             String
  weeklyFocusId      String
  date               DateTime
  status             String   @default("provisional") // provisional | materialized | superseded
  plannedBlocks      Json
  expectedMinutes    Int
  focusLinks         String[]
  dueReviewPressure  Json
  rationaleSnapshots Json
  methodologyVersion String
  inputSnapshot      Json
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, status])
  @@index([weeklyFocusId, date])
}

// Append-only explanation of a focus or forecast replacement. Artifact ids are scalar
// snapshots so deletion/supersession never destroys the historic link text.
model ProgramRevision {
  id                 String   @id @default(cuid())
  userId             String
  previousFocusId    String?
  newFocusId         String?
  previousForecastId String?
  newForecastId      String?
  trigger            String
  changedFields      Json
  gradedDecisions    Json
  methodologyVersion String
  occurredAt         DateTime
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

// --- Engagement plumbing (BUILD.md §5.7, §9, M9) ---

// A fired engagement event (Seam 9 decides which/when/copy; the Engine fires/persists).
// Append-only like the tracker. `type` is the ALLOWED reward-event taxonomy (streak_tick |
// competence_milestone | consistency_grid | recovery_prompt) — forbidden mechanics (global
// leaderboards, infinite streaks, tangible/contingent rewards) are not representable, so the
// forbid list is structural, not a runtime check. `copyKey` resolves to a Seam-8 rationale
// entry at render time, so the evidence grade travels with the copy (L3). `payload` carries
// the capped streak position / milestone the UI shows; `seen` lets the UI dismiss a nudge.
model RewardEvent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  copyKey    String
  occurredAt DateTime
  payload    Json
  seen       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

// Capped, user-configurable reminders (anti-nag, Seam 9). One row per user. `cadenceCap` is
// clamped to the Seam-9 config ceiling (reminderCadenceCapPerDay) by the Engine before write
// — the cap is methodology, enforced in code, and can never be exceeded by a client. Default
// disabled / no channel (reminders are off until the user opts in).
model NotificationPref {
  id         String   @id @default(cuid())
  userId     String   @unique
  channel    String   @default("none") // none | email | push
  cadenceCap Int      @default(0) // reminders/day, ≤ config cap
  enabled    Boolean  @default(false)
  quietHours String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
